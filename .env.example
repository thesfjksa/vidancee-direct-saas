NODE_ENV=production
PORT=3000
APP_URL=https://ai.mehroz.online

# Provider credentials are managed from /admin-console -> Provider.
# Legacy provider ENV values are still imported once when present, but new setups
# should configure Vidancee, CreatePulse, and Atlas Cloud in the Admin dashboard.

# Long random secret used to sign temporary provider-accessible reference-image URLs.
# ADMIN_TOKEN is used as fallback if this is blank.
PROVIDER_ASSET_SECRET=

ADMIN_TOKEN=
SETTINGS_ENCRYPTION_KEY=
ALLOW_PROVIDER_CHARGES=yes

# MySQL — required for Milestone 2
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=10

# Customer accounts
ALLOW_SIGNUPS=yes
STARTING_CREDITS=0
SESSION_DAYS=30

# Worker
WORKER_ENABLED=true
WORKER_POLL_MS=5000

# Customer credit pricing.
# Defaults below match provider-credit observations for confirmed combinations.
PRICE_SEEDANCE_25_10=6
PRICE_SEEDANCE_25_15=9
# Optional: set this to expose Seedance 2.5 20s in the customer dashboard.
PRICE_SEEDANCE_25_20=
PRICE_SEEDANCE_25_30=14
PRICE_SEEDANCE_20_FAST_10=5
# Leave unconfirmed fast-duration pricing blank until you choose a customer price.
PRICE_SEEDANCE_20_FAST_15=
PRICE_SEEDANCE_20_FAST_30=


# Customer image-generation credit pricing (Atlas Cloud).
PRICE_IMAGE_SEEDREAM_50_LITE=2
PRICE_IMAGE_NANO_BANANA_2=3
