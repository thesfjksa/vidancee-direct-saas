NODE_ENV=production
PORT=3000
APP_URL=https://ai.mehroz.online

VIDANCEE_BASE_URL=https://vidancee.com
VIDANCEE_EMAIL=
VIDANCEE_PASSWORD=

# Required for the temporary Milestone-1 admin console.
# Use a long random value and keep it only in hPanel environment variables.
ADMIN_TOKEN=

# Safety switch. Leave "no" until provider login/jobs check succeeds.
ALLOW_PROVIDER_CHARGES=no

PROVIDER_POLL_INTERVAL_MS=5000
PROVIDER_JOB_TIMEOUT_MS=1200000
