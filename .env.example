NODE_ENV=production
PORT=3000
APP_URL=https://cmmtools.site
# Set only after the Chrome Web Store listing is published. 32 letters a-p.
# Blank/invalid keeps the install page in its honest not-yet-available state.
CHROME_WEB_STORE_EXTENSION_ID=
# APP_URL must be the public HTTPS origin (used for provider reference-image links).

# Provider credentials are managed from /admin-console -> Provider.
# Legacy provider ENV values are still imported once when present, but new setups
# should configure providers in the Admin dashboard.

# Long random secret used to sign temporary provider-accessible reference-image URLs.
# ADMIN_TOKEN is used as fallback if this is blank.
PROVIDER_ASSET_SECRET=

ADMIN_TOKEN=
SETTINGS_ENCRYPTION_KEY=
ALLOW_PROVIDER_CHARGES=yes

# MySQL — required for Milestone 2
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=10

# Customer accounts
ALLOW_SIGNUPS=yes
STARTING_CREDITS=0
SESSION_DAYS=30

# Worker
# Customer web app (server.js) must use false. The separate worker.js app
# must explicitly use WORKER_ENABLED=true in its Hostinger environment.
# Web-only wake endpoint for the separate generation worker (blank disables wake requests).
WORKER_WAKE_URL=https://worker.mehroz.online/live
WORKER_ENABLED=false
WORKER_POLL_MS=5000

# Fixed-price video models (MiniMax H3 on vgenv) are priced in code at cost
# (src/pricing.js): 24 credits per rupee of source cost. There are no price variables.



# Optional: imported into encrypted Admin settings when no saved key exists.
# Prefer setting the AI Gateway API key from the Admin Provider tab.
AI_GATEWAY_API_KEY=
AI_GATEWAY_ENABLED=true
AI_GATEWAY_MAX_INFLIGHT=2

# Optional: imported into encrypted Admin settings when no saved key exists (Higgsfield API: Wan 3.0), as KEY_ID:KEY_SECRET.
HIGGSFIELD_API_KEY=
# Sluice (getsluice.com) key for Seedance Lite, slu_live_…
SLUICE_API_KEY=

# Google Drive video storage
# Preferred setup: Admin -> Storage -> Google OAuth credentials, then Connect.
# No GOOGLE_DRIVE_* environment variables are required. Client ID, secret,
# and Google refresh token are stored encrypted in shared MySQL app_settings.
# Existing Hostinger GOOGLE_DRIVE_CLIENT_ID/SECRET values are accepted as
# legacy fallback only, and can be migrated into Admin without a code change.
# Authorized redirect URI: https://cmmtools.site/admin/google-drive/callback
# Never commit real Client Secrets, tokens or signed media links to GitHub.


# AIVID Browserless pilot. No customer model is registered yet.
# Configure the Browserless key and AIVID login in Admin -> Provider.
# The following are optional legacy/CLI fallbacks; Admin settings take priority.
# Keep tokens and session connect URLs private; never use PUBLIC_ env names.
BROWSERLESS_API_TOKEN=
BROWSERLESS_ENDPOINT=https://production-sfo.browserless.io
BROWSERLESS_SESSION_TTL_MS=86400000
# Alternatively configure the saved session's connect URL on BOTH app hosts.
AIVID_BROWSERLESS_CONNECT_URL=
AIVID_ENABLED=false
AIVID_MAX_SOURCE_CREDITS=0

# Private AIVID embedded live-browser pilot (off unless explicitly enabled)
AIVID_LIVE_VIEW_ENABLED=false
AIVID_LIVE_VIEW_ALLOWED_EMAILS=
AIVID_LIVE_VIEW_ALLOWED_IDS=
AIVID_LIVE_VIEW_BROWSERLESS_WS=
AIVID_LIVE_VIEW_DIRECT_BILLING_ACK=false
