NODE_ENV=production
PORT=3000
APP_URL=https://ai.mehroz.online

VIDANCEE_BASE_URL=https://vidancee.com
VIDANCEE_EMAIL=
VIDANCEE_PASSWORD=

ADMIN_TOKEN=
ALLOW_PROVIDER_CHARGES=yes

# MySQL — required for Milestone 2
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=10

# Customer accounts
ALLOW_SIGNUPS=yes
STARTING_CREDITS=0
SESSION_DAYS=30

# Worker
WORKER_ENABLED=true
WORKER_POLL_MS=5000

# Customer credit pricing.
# Defaults below match provider-credit observations for confirmed combinations.
PRICE_SEEDANCE_25_10=6
PRICE_SEEDANCE_25_15=9
PRICE_SEEDANCE_25_30=14
PRICE_SEEDANCE_20_FAST_10=5
# Leave unconfirmed fast-duration pricing blank until you choose a customer price.
PRICE_SEEDANCE_20_FAST_15=
PRICE_SEEDANCE_20_FAST_30=
