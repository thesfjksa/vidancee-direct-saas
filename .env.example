NODE_ENV=production
PORT=3000
APP_URL=https://cmmtools.site
# APP_URL must be the public HTTPS origin (used for provider reference-image links).

# Provider credentials are managed from /admin-console -> Provider.
# Legacy provider ENV values are still imported once when present, but new setups
# should configure providers in the Admin dashboard.

# Long random secret used to sign temporary provider-accessible reference-image URLs.
# ADMIN_TOKEN is used as fallback if this is blank.
PROVIDER_ASSET_SECRET=

ADMIN_TOKEN=
SETTINGS_ENCRYPTION_KEY=
ALLOW_PROVIDER_CHARGES=yes

# MySQL — required for Milestone 2
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=10

# Customer accounts
ALLOW_SIGNUPS=yes
STARTING_CREDITS=0
SESSION_DAYS=30

# Worker
# Web-only wake endpoint for the separate generation worker (blank disables wake requests).
WORKER_WAKE_URL=https://worker.mehroz.online/live
WORKER_ENABLED=true
WORKER_POLL_MS=5000

# Universal commercial rule:
# customer credits = source billing units × CUSTOMER_CREDIT_MULTIPLIER.
# Fractional credits are supported to keep the 2.5× rule exact.
CUSTOMER_CREDIT_MULTIPLIER=2.5

# Source-site billing units for Seedance. These are multiplied by 2.5 before
# they are shown/deducted from customers.
PRICE_SEEDANCE_25_10=6
PRICE_SEEDANCE_25_15=9
# Optional: set this source cost to expose Seedance 2.5 20s.
PRICE_SEEDANCE_25_20=
PRICE_SEEDANCE_25_30=14
PRICE_SEEDANCE_20_FAST_10=5

# vgenv MiniMax H3 Fast supports 480p and 768p.
# We normalize source USD cents as source billing units before the 2.5× markup.
# Default source rates: 480p $0.0015/sec -> 0.15 units/sec;
# 768p $0.003/sec -> 0.3 units/sec.
SOURCE_MINIMAX_H3_FAST_480P_CREDITS_PER_SECOND=0.15
SOURCE_MINIMAX_H3_FAST_768P_CREDITS_PER_SECOND=0.3



# Optional: imported into encrypted Admin settings when no saved key exists.
# Prefer setting the AI Gateway API key from the Admin Provider tab.
AI_GATEWAY_API_KEY=
AI_GATEWAY_ENABLED=true
AI_GATEWAY_MAX_INFLIGHT=2
